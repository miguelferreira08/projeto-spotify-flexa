rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // TROQUE pelo UID real da sua conta administrativa do Firebase Authentication.
      return signedIn() && request.auth.uid == 'COLE_AQUI_O_UID_DA_CONTA_ADMIN';
    }

    match /tracks/{trackId} {
      // Usuários logados podem ver o catálogo.
      allow read: if signedIn();

      // Somente o administrador pode criar, editar ou apagar músicas.
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      // Cada usuário só pode criar/ler/atualizar o próprio perfil.
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
