rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // UID do administrador. Deve ser o mesmo usado no config.js e no firestore.rules.
      return signedIn() && request.auth.uid == 'aGxAVvsRyVVzjgf2LcV0GImQXRp2';
    }

    match /audio/{trackId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && (
          request.resource == null
          || (
            request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType.matches('audio/(mpeg|mp3)')
          )
        );
    }

    match /covers/{trackId}/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && (
          request.resource == null
          || (
            request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')
          )
        );
    }
  }
}